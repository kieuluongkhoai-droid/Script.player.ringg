----------------------------------------------------------------
-- HÀM TÌM MỤC TIÊU (TỐI ƯU CHO GAME PHÉP THUẬT)
----------------------------------------------------------------
local function GetClosestPlayer()
    local closestPlayer = nil
    local shortestDistance = math.huge

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            local character = player.Character
            local rootPart = character:FindFirstChild(TargetPart) or character:FindFirstChild("HumanoidRootPart")
            local humanoid = character:FindFirstChildOfClass("Humanoid")
            
            if rootPart and humanoid and humanoid.Health > 0 then
                -- Kiểm tra thêm nếu nhân vật có team khác (tránh tự bắn đồng đội nếu game có chia đội)
                local isEnemy = true
                if LocalPlayer.Team and player.Team and LocalPlayer.Team == player.Team then
                    isEnemy = false
                end
                
                if isEnemy then
                    local screenPoint, onScreen = Camera:WorldToViewportPoint(rootPart.Position)
                    local mouseLocation = UserInputService:GetMouseLocation()
                    local distance = (Vector2.new(screenPoint.X, screenPoint.Y) - mouseLocation).Magnitude

                    if distance < shortestDistance then
                        shortestDistance = distance
                        closestPlayer = player
                    end
                end
            end
        end
    end

    return closestPlayer
end

----------------------------------------------------------------
-- VÒNG LẶP XỬ LÝ LIÊN TỤC
----------------------------------------------------------------
RunService.RenderStepped:Connect(function()
    -- 1. Aimbot Logic
    if AimbotEnabled and UserInputService:IsMouseButtonPressed(AimKey) then
        local closestTarget = GetClosestPlayer()
        if closestTarget and closestTarget.Character then
            local targetPartObj = closestTarget.Character:FindFirstChild(TargetPart) or closestTarget.Character:FindFirstChild("HumanoidRootPart")
            if targetPartObj then
                Camera.CFrame = CFrame.new(Camera.CFrame.Position, targetPartObj.Position)
            end
        end
    end

    -- 2. ESP Logic
    for player, espData in pairs(ESPStorage) do
        local character = player.Character
        local humanoid = character and character:FindFirstChildOfClass("Humanoid")
        local rootPart = character and (character:FindFirstChild("HumanoidRootPart") or character:FindFirstChild("Torso"))

        if ESPEnabled and character and humanoid and rootPart and humanoid.Health > 0 then
            local rootPos, rootOnScreen = Camera:WorldToViewportPoint(rootPart.Position)
            local topPos = Camera:WorldToViewportPoint(rootPart.Position + Vector3.new(0, 3, 0))
            local legPos = Camera:WorldToViewportPoint(rootPart.Position - Vector3.new(0, 3, 0))

            if rootOnScreen then
                local height = math.abs(topPos.Y - legPos.Y)
                local width = height / 2

                espData.Box.Size = Vector2.new(width, height)
                espData.Box.Position = Vector2.new(rootPos.X - width / 2, rootPos.Y - height / 2)
                espData.Box.Visible = true

                espData.NameTag.Text = player.Name .. " [" .. math.floor(humanoid.Health) .. "HP]"
                espData.NameTag.Position = Vector2.new(rootPos.X, (rootPos.Y - height / 2) - 18)
                espData.NameTag.Visible = true
            else
                espData.Box.Visible = false
                espData.NameTag.Visible = false
            end
        else
            espData.Box.Visible = false
            espData.NameTag.Visible = false
        end
    end
end)
