-- 2. HỆ THỐNG ESP (SỬ DỤNG HIGHLIGHT AN TOÀN)
----------------------------------------------------------------
local ESPStorage = {}

local function UpdateESP(player)
    if player == LocalPlayer then return end
    
    local character = player.Character
    if character and ESPEnabled then
        -- Kiểm tra xem đã có Highlight chưa, chưa có thì tạo mới
        local highlight = character:FindFirstChild("MEB_Highlight")
        if not highlight then
            highlight = Instance.new("Highlight")
            highlight.Name = "MEB_Highlight"
            highlight.Adornee = character
            highlight.FillColor = Color3.fromRGB(0, 255, 100)
            highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
            highlight.FillTransparency = 0.5
            highlight.OutlineTransparency = 0
            highlight.Parent = character
        end
        highlight.Enabled = true
    else
        if character then
            local highlight = character:FindFirstChild("MEB_Highlight")
            if highlight then
                highlight.Enabled = false
            end
        end
    end
end

