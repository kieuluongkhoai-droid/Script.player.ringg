----------------------------------------------------------------
-- 2. SMOOTH AIMBOT SYSTEM
----------------------------------------------------------------
local function GetClosestPlayer()
    local target = nil
    local shortestDistance = math.huge
    local mouseLocation = UserInputService:GetMouseLocation()

    for _, v in pairs(Players:GetPlayers()) do
        if v ~= LocalPlayer and v.Character then
            local humanoid = v.Character:FindFirstChildOfClass("Humanoid")
            -- Check if character is alive
            if humanoid and humanoid.Health > 0 then
                -- Check team validity
                if not getgenv().TeamCheck or v.Team ~= LocalPlayer.Team then
                    local part = v.Character:FindFirstChild(getgenv().AimPart)
                    if part then
                        local screenPoint, onScreen = Camera:WorldToScreenPoint(part.Position)
                        -- Only targets currently visible on screen
                        if onScreen then
                            local screenPos = Vector2.new(screenPoint.X, screenPoint.Y)
                            local distance = (screenPos - mouseLocation).Magnitude

                            if distance < shortestDistance then
                                shortestDistance = distance
                                target = part
                            end
                        end
                    end
                end
            end
        end
    end
    return target
end

-- Continuous smooth camera update loop per frame
RunService.RenderStepped:Connect(function()
    if getgenv().AimbotEnabled then
        local targetPart = GetClosestPlayer()
        if targetPart then
            local currentCFrame = Camera.CFrame
            local targetCFrame = CFrame.new(currentCFrame.Position, targetPart.Position)
            
            -- Use Lerp to create smoothness and prevent camera snapping/stuttering
            Camera.CFrame = currentCFrame:Lerp(targetCFrame, getgenv().Smoothness)
        end
    end
end)
